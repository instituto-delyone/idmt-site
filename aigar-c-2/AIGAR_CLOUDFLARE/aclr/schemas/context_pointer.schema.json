{
  "$schema":"https://json-schema.org/draft/2020-12/schema","title":"AIGAR Context Pointer","type":"object",
  "required":["pointer_id","schema_version","target_type","target_id","domain_ids","concept_ids","provenance","status"],
  "properties":{
    "pointer_id":{"type":"string"},"schema_version":{"type":"string"},
