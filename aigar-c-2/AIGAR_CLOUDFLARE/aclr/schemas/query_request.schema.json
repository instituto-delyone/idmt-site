{
  "$schema":"https://json-schema.org/draft/2020-12/schema","title":"AIGAR Query Request","type":"object",
  "required":["query_id","question","language","request_mode"],
  "properties":{
    "query_id":{"type":"string","minLength":1},"question":{"type":"string","minLength":1},
    "conversation_context":{"type":"array","items":{"type":"object"}},
    "language":{"type":"string"},"requested_domains":{"type":"array","items":{"type":"string"}},
    "top_k":{"type":"integer","minimum":1,"maximum":100,"default":5},
    "request_mode":{"type":"string"},"trace":{"type":"boolean","default":false}
  },"additionalProperties":false
}