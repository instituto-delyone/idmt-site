{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "aigar-api",
  "main": "main.py",
  "compatibility_date": "2026-10-08",
  "compatibility_flags": [
    "python_workers",
    "python_workflows",
    "disable_python_external_sdk"
  ],
  "ai": { "binding": "AI" },
  "d1_databases": [
    {
      "binding": "AIGAR_DB",
      "database_name": "AIGAR",
      "database_id": "8e73d3a8-09cd-4b82-b59e-cc5705afa922"
    }
  ],
  "r2_buckets": [
    {
      "binding": "AIGAR_LIBRARY_BUCKET",
      "bucket_name": "aigar-library"
    }
  ],
  "workflows": [
    {
      "name": "aigar-library-builder",
      "binding": "AIGAR_LIBRARY_BUILDER",
      "class_name": "LibraryBuilderWorkflow"
    }
  ]
}
